{
  "name": "sigint-fusion-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:browser": "tsc --noEmit && vite build --mode browser --outDir dist-browser",
